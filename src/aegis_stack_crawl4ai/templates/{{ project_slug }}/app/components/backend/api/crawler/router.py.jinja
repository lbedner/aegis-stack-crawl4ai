"""FastAPI router for the crawler service.

Lives here rather than in the service package for the same reason
every in-tree service's router does: the service is business logic,
the HTTP layer belongs to the backend component. Mounted at
``/api/v1/crawler`` by the ``RouterWiring`` entry in the plugin spec.

Endpoints:
- ``POST /crawl`` — fetch one URL synchronously, return the stored doc.
- ``POST /wayback`` — fetch an archived site from the Wayback Machine.
- ``GET /sites`` — the crawled sites, with counts.
- ``POST /sites/{site}/assets`` — fetch the site's missing assets, as a job.
- ``GET /sites/{site}/export`` — a site as a zip of plain files.
- ``POST /sites/{site}/export`` — that zip kept in the object store.
- ``GET /pages`` — list recent pages, optionally for one site.
- ``GET /pages/{page_id}`` — fetch a single stored page.
- ``GET /pages/{page_id}/assets`` — the files that page references.
"""

from __future__ import annotations

from fastapi import APIRouter, Depends, HTTPException, Query, status
from fastapi.responses import JSONResponse, Response
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.db import get_async_db
from app.services.crawler import queries
from app.services.crawler.deps import get_crawler_service
from app.services.crawler.domains.export import export_site, store_export
from app.services.crawler.jobs import start_assets, start_crawl, start_wayback
from app.services.crawler.models import CrawledAsset, CrawledPage
from app.services.crawler.schemas import (
    BatchCrawlRequest,
    CrawledAssetRead,
    CrawledPageRead,
    CrawledPageSummary,
    CrawlerSite,
    CrawlerStats,
    CrawlRequest,
    StoredExport,
    WaybackRequest,
)
from app.services.crawler.service import CrawlerService

router = APIRouter()


@router.post(
    "/crawl",
    response_model=CrawledPageRead,
    status_code=status.HTTP_201_CREATED,
)
async def crawl_url(
    payload: CrawlRequest,
    crawler: CrawlerService = Depends(get_crawler_service),
    session: AsyncSession = Depends(get_async_db),
) -> CrawledPage:
    """Fetch one URL and persist the result."""
    return await crawler.fetch(
        session,
        url=str(payload.url),
        doc_metadata=payload.doc_metadata,
        source_kind=payload.source_kind,
        fresh=payload.fresh,
    )


@router.post("/crawl-batch", status_code=status.HTTP_202_ACCEPTED)
async def crawl_batch(payload: BatchCrawlRequest) -> JSONResponse:
    """Start a crawl in the background and hand back its job id.

    Progress is the framework's, not ours: the caller reads
    ``/api/v1/jobs/{job_id}/events`` until the job lands.
    """
    job_id = await start_crawl(
        [str(url) for url in payload.urls],
        options=payload.options,
        source_kind=payload.source_kind,
    )
    return JSONResponse(
        {"job_id": job_id}, status_code=status.HTTP_202_ACCEPTED
    )


@router.post("/wayback", status_code=status.HTTP_202_ACCEPTED)
async def crawl_wayback(payload: WaybackRequest) -> JSONResponse:
    """Fetch every archived page of a site, as a background job."""
    job_id = await start_wayback(payload)
    return JSONResponse(
        {"job_id": job_id}, status_code=status.HTTP_202_ACCEPTED
    )


@router.get("/sites")
async def list_sites(
    crawler: CrawlerService = Depends(get_crawler_service),
    session: AsyncSession = Depends(get_async_db),
) -> list[CrawlerSite]:
    """Every crawled site with its page and failure counts."""
    return await crawler.sites(session)


@router.post("/sites/{site}/assets", status_code=status.HTTP_202_ACCEPTED)
async def site_assets(site: str) -> JSONResponse:
    """Fetch every asset the site's stored pages name and do not have yet."""
    job_id = await start_assets(site)
    return JSONResponse(
        {"job_id": job_id}, status_code=status.HTTP_202_ACCEPTED
    )


@router.get("/sites/{site}/export")
async def export(
    site: str,
    session: AsyncSession = Depends(get_async_db),
) -> Response:
    """The site as a zip of plain files: pages, assets, a manifest."""
    data = await export_site(session, site)
    return Response(
        content=data,
        media_type="application/zip",
        headers={"Content-Disposition": f'attachment; filename="{site}.zip"'},
    )


@router.post("/sites/{site}/export", response_model=StoredExport)
async def keep_export(
    site: str,
    session: AsyncSession = Depends(get_async_db),
) -> StoredExport:
    """The site's export written to the object store; its key and a
    link when the store gives one."""
    return await store_export(session, site)


@router.get("/pages", response_model=list[CrawledPageSummary])
async def list_pages(
    limit: int = Query(default=50, ge=1, le=500),
    failed_only: bool = Query(default=False),
    site: str | None = Query(default=None, max_length=255),
    crawler: CrawlerService = Depends(get_crawler_service),
    session: AsyncSession = Depends(get_async_db),
) -> list[CrawledPage]:
    """Most recent pages, newest first. ``site`` narrows to one host."""
    return await crawler.list_pages(
        session, limit=limit, failed_only=failed_only, site=site
    )


@router.get("/pages/{page_id}", response_model=CrawledPageRead)
async def get_document(
    page_id: int,
    session: AsyncSession = Depends(get_async_db),
) -> CrawledPage:
    """Fetch a stored document by id."""
    document = await session.get(CrawledPage, page_id)
    if document is None:
        raise HTTPException(status_code=404, detail="CrawledPage not found")
    return document


@router.get("/pages/{page_id}/assets", response_model=list[CrawledAssetRead])
async def page_assets(
    page_id: int,
    session: AsyncSession = Depends(get_async_db),
) -> list[CrawledAsset]:
    """The assets first seen on one stored page."""
    return await queries.page_assets(session, page_id)


@router.get("/stats")
async def crawler_stats(
    crawler: CrawlerService = Depends(get_crawler_service),
    session: AsyncSession = Depends(get_async_db),
) -> CrawlerStats:
    """Aggregate counts, distinct URLs, content-type split, last fetch.

    Returns ``{pages, failed, unique_urls, content_types,
    last_fetched_at}``.
    Same numbers ``crawler_health`` reports under
    ``ComponentStatus.metadata`` — the dashboard modal calls this route
    so it never relies on stale health-poll snapshots.
    """
    return await crawler.stats(session)
