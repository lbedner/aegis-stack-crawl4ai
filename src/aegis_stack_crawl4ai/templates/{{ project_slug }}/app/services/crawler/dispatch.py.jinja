"""Where a crawl runs: the worker when the stack has one, else here.

The CLI, the Overseer and the jobs API never know which. A job id comes
back either way; progress and the result arrive through the framework's
``/api/v1/jobs/{job_id}/events``. With a worker, the webserver only
records the job and enqueues it, so a webserver restart leaves the crawl
running; without one, the crawl is a background task in this process.
"""

from typing import Any

from app.services.crawler.jobs import run_job_kind
from app.services.crawler.options import CrawlOptions
from app.services.crawler.schemas import WaybackRequest
from app.services.system.jobs import JobHandle, get_job_runner

QUEUE = "crawler"
TASK = "crawl_task"


async def start_in_process(
    name: str, label: str, kind: str, payload: dict[str, Any]
) -> str:
    """Run the job as an asyncio task in this process."""

    async def work(handle: JobHandle) -> dict[str, Any]:
        # The job result rides an SSE frame as JSON, so the model is
        # dumped exactly here, at that boundary, and nowhere earlier.
        summary = await run_job_kind(kind, payload, report=handle.label_writer())
        return summary.model_dump()

    return get_job_runner().start(name, work, label=label)


{%- if include_worker %}


def _store() -> Any:
    from app.services.system.job_store import RedisJobStore

    return RedisJobStore.shared()


async def _enqueue(task: str, queue: str, *args: Any) -> None:
    from app.components.worker.pools import enqueue_task

    await enqueue_task(task, queue, *args)


async def _start(name: str, label: str, kind: str, payload: dict[str, Any]) -> str:
    """Record the job in the shared store, then hand it to the worker."""
    import uuid

    from app.core.log import logger

    job_id = uuid.uuid4().hex
    store = _store()
    try:
        await store.create(job_id, name, label)
        try:
            await _enqueue(TASK, QUEUE, job_id, kind, payload)
        except Exception as exc:
            # The record outlives this function, so a failed hand-off has
            # to be written into it: otherwise the job sits queued until
            # it expires, with the reason only in this process's logs.
            await store.fail(job_id, f"Could not queue the crawl: {exc}")
            raise
    finally:
        await store.aclose()
    logger.info("crawler.enqueued", job_id=job_id, kind=kind)
    return job_id
{%- else %}


# No worker in this stack: the background path is this process.
_start = start_in_process
{%- endif %}


async def start_crawl(
    urls: list[str],
    *,
    options: CrawlOptions | None = None,
    source_kind: str = "crawl4ai",
) -> str:
    """Start the crawl and return the id its progress streams under."""
    payload = {
        "urls": urls,
        "options": (options or CrawlOptions()).model_dump(),
        "source_kind": source_kind,
    }
    return await _start(
        f"crawler-batch:{len(urls)}", f"Queued {len(urls)} URL(s)...", "crawl", payload
    )


async def start_wayback(request: WaybackRequest) -> str:
    """Start the archive pull and return the id its progress streams under."""
    return await _start(
        f"crawler-wayback:{request.domain}",
        f"Listing {request.domain} in the archive...",
        "wayback",
        request.model_dump(),
    )


async def start_assets(site: str) -> str:
    """Start the per-site asset backfill and return its job id."""
    return await _start(
        f"crawler-assets:{site}", f"Listing {site}'s pages...", "assets", {"site": site}
    )

