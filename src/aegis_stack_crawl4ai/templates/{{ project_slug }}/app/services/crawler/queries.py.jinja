"""Reads for the crawler service.

Statement builders and their execution, nothing else: no writes, no
business logic. Everything that asks the store a question comes
through here, which is what makes an N+1 audit a read of one file.
"""

from __future__ import annotations

from datetime import datetime
from typing import Any

from sqlalchemy import ColumnElement, and_, case, func, not_, or_
from sqlalchemy.orm import defer
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.services.crawler.models import CrawledAsset, CrawledPage
from app.services.crawler.utils import page_key

_FAILED = or_(
    CrawledPage.status_code.is_(None),
    CrawledPage.status_code >= 400,
    and_(CrawledPage.content.is_(None), CrawledPage.html.is_(None)),
)
"""A fetch that produced nothing usable: refused, or answered with nothing
kept (a page crawl4ai's block heuristic failed, before its bytes were
kept), so a re-run asks again. Shared so the stats, the per-site counts
and the retry queue cannot drift apart on what "failed" means."""

_IN_CHUNK = 900


async def page_with_hash(
    db: AsyncSession, *, url: str, content_hash: str
) -> CrawledPage | None:
    """The most recent row for this URL whose body hashed the same.

    The dedup gate on the write path: a hit means the fetch changed
    nothing and needs no new row.
    """
    return (
        await db.exec(
            select(CrawledPage)
            .where(CrawledPage.source_url == url)
            .where(CrawledPage.content_hash == content_hash)
            .order_by(CrawledPage.fetched_at.desc())
            .limit(1)
        )
    ).first()


_ASSET_SETTLED = or_(
    CrawledAsset.storage_key.is_not(None),
    and_(
        CrawledAsset.status_code >= 400,
        CrawledAsset.status_code < 500,
        CrawledAsset.status_code != 429,
    ),
)
"""An asset the store holds, or one the host definitely has not got.
A throttle or an outage is neither, so it gets asked for again."""


async def _present(
    db: AsyncSession, column: Any, urls: list[str], *where: ColumnElement[bool]
) -> set[str]:
    """Which of ``urls`` have a row matching ``where``, by ``column``.

    One ``IN`` query per chunk of URLs rather than one per URL; chunked
    because SQLite caps bound parameters at 999 on older builds.
    """
    found: set[str] = set()
    for start in range(0, len(urls), _IN_CHUNK):
        rows = await db.exec(
            select(column).where(column.in_(urls[start : start + _IN_CHUNK]), *where)
        )
        found.update(str(url) for url in rows.all())
    return found


async def site_page_keys(db: AsyncSession, site: str) -> set[str]:
    """The pages a site holds a successful fetch of, as ``page_key``s, so
    the archive's spelling of a page the live crawl stored is held too."""
    rows = await db.exec(
        select(CrawledPage.source_url).where(CrawledPage.site == site, not_(_FAILED))
    )
    return {page_key(str(url)) for url in rows.all()}


async def stored_asset_urls(db: AsyncSession, site: str, urls: list[str]) -> set[str]:
    """Which of ``urls`` the site already has settled, held or a definite miss."""
    return await _present(
        db, CrawledAsset.original_url, urls, CrawledAsset.site == site, _ASSET_SETTLED
    )


async def page_assets(db: AsyncSession, page_id: int) -> list[CrawledAsset]:
    """The assets first seen on one page."""
    return list(
        (
            await db.exec(
                select(CrawledAsset)
                .where(CrawledAsset.page_id == page_id)
                .order_by(CrawledAsset.id)
            )
        ).all()
    )


async def recent_pages(
    db: AsyncSession,
    *,
    limit: int = 50,
    failed_only: bool = False,
    site: str | None = None,
) -> list[CrawledPage]:
    """The most recent N pages, newest first, without their HTML: a
    listing is a summary, and five hundred bodies is a lot to discard."""
    stmt = (
        select(CrawledPage)
        .options(defer(CrawledPage.html))
        .order_by(CrawledPage.fetched_at.desc())
        .limit(limit)
    )
    if site:
        stmt = stmt.where(CrawledPage.site == site)
    if failed_only:
        stmt = stmt.where(_FAILED)
    return list((await db.exec(stmt)).all())


async def site_rollup(db: AsyncSession) -> list[tuple[Any, Any, Any, Any]]:
    """Per-site counts: site, pages, failed, last fetch.

    One grouped query over the stored ``site`` column, so a deep crawl
    of a thousand pages is still one row. Ordered by size, because the
    site someone crawled hardest is the one they come back for.
    """
    rows = await db.exec(
        select(
            CrawledPage.site,
            func.count(CrawledPage.id),
            func.sum(case((_FAILED, 1), else_=0)),
            func.max(CrawledPage.fetched_at),
        )
        .where(CrawledPage.site.is_not(None))
        .group_by(CrawledPage.site)
        .order_by(func.count(CrawledPage.id).desc(), CrawledPage.site)
    )
    return list(rows.all())


async def totals(db: AsyncSession) -> tuple[int, int, int, datetime | None]:
    """Pages, failed, distinct URLs and the last fetch, in one statement.

    Four aggregates over the same rows is one scan, not four round
    trips. Distinct URLs against the total is the store's re-fetch
    depth, which is why both are counted.
    """
    row = (
        await db.exec(
            select(
                func.count(CrawledPage.id),
                func.sum(case((_FAILED, 1), else_=0)),
                func.count(func.distinct(CrawledPage.source_url)),
                func.max(CrawledPage.fetched_at),
            )
        )
    ).one()
    pages, failed, unique_urls, last = row
    return int(pages or 0), int(failed or 0), int(unique_urls or 0), last


async def content_type_counts(db: AsyncSession) -> dict[str, int]:
    """One grouped query, not one per type."""
    rows = await db.exec(
        select(CrawledPage.content_type, func.count(CrawledPage.id)).group_by(
            CrawledPage.content_type
        )
    )
    return {str(name or "unknown"): int(count) for name, count in rows.all()}


def _newest(model: Any, key: Any, *where: ColumnElement[bool]) -> Any:
    """The id of the newest row per ``key``: the tables are append logs,
    and rows land in fetch order, so the highest id is the latest."""
    return select(func.max(model.id)).where(*where).group_by(key)


async def site_pages(db: AsyncSession, site: str) -> list[CrawledPage]:
    """Every page of a site, its latest successful fetch only, by URL.

    Only the newest row per URL leaves the database; the stale bodies
    of earlier fetches are never loaded.
    """
    newest = _newest(
        CrawledPage, CrawledPage.source_url, CrawledPage.site == site, not_(_FAILED)
    )
    rows = await db.exec(
        select(CrawledPage)
        .where(CrawledPage.id.in_(newest))
        .order_by(CrawledPage.source_url)
    )
    return list(rows.all())


async def site_assets(db: AsyncSession, site: str) -> list[CrawledAsset]:
    """Every stored asset of a site, by URL."""
    newest = _newest(
        CrawledAsset,
        CrawledAsset.original_url,
        CrawledAsset.site == site,
        CrawledAsset.storage_key.is_not(None),
    )
    rows = await db.exec(
        select(CrawledAsset)
        .where(CrawledAsset.id.in_(newest))
        .order_by(CrawledAsset.original_url)
    )
    return list(rows.all())
