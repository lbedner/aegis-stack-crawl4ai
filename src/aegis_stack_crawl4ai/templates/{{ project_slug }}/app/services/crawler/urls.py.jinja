"""Turning what someone typed into something fetchable.

``example.com`` is what people write, in the dashboard and on the CLI.
``HttpUrl`` refuses it: no scheme, so it parses as a relative reference.
Rejecting that with a validation error is the crawler being pedantic
about a case it can obviously resolve, so it resolves it here, once, on
the way into every request model.
"""

from urllib.parse import urlsplit, urlunsplit

_SCHEMES = ("http://", "https://")
_DEFAULT_PORTS = {"http": 80, "https": 443}


def normalize_url(raw: str) -> str:
    """The URL to fetch for what the user typed.

    A missing scheme becomes ``https://``. Anything that already names a
    scheme is left exactly as it is, including ``http://``: downgrading
    is the caller's choice to make, not ours. Whitespace is trimmed
    because a pasted list carries it.
    """
    candidate = raw.strip()
    if not candidate or candidate.startswith(_SCHEMES):
        return candidate
    if "://" in candidate:
        # Some other scheme entirely (ftp, file). Let the URL type judge it.
        return candidate
    return f"https://{candidate}"


def canonical_url(url: str) -> str:
    """One spelling per page: lowercase host, no default port, ``/`` for
    an empty path. The form ``HttpUrl`` produces, so a row filed from a
    CDX listing (``http://host:80/x``) and one from a live crawl agree."""
    try:
        parts = urlsplit(url)
    except ValueError:
        return url
    if not parts.hostname:
        return url
    host = parts.hostname.lower()
    if parts.port and parts.port != _DEFAULT_PORTS.get(parts.scheme.lower()):
        host = f"{host}:{parts.port}"
    if parts.username:
        auth = parts.username + (f":{parts.password}" if parts.password else "")
        host = f"{auth}@{host}"
    return urlunsplit(
        (parts.scheme.lower(), host, parts.path or "/", parts.query, parts.fragment)
    )
