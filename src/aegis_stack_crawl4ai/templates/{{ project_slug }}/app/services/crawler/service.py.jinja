"""Crawler service — async wrapper around ``crawl4ai.AsyncWebCrawler``.

Provides a ``CrawlerService`` class with two surfaces:

- ``fetch(url, doc_metadata=...)`` — fetch one URL, persist the
  result, return the stored ``CrawledPage`` row.
- ``batch_fetch(urls, ...)`` — concurrent fetch of many URLs, persist
  each independently. Failures are recorded with their HTTP status
  and the surviving rows let you query for retries.

Persistence is generic: every fetch becomes a row in ``crawler.crawled_page``
with ``source_url``, ``content``, ``content_hash`` (sha256), and a free-
form ``doc_metadata`` JSONB. Re-fetching the same URL appends a new row;
dedup-by-hash is a query the consumer runs when they care, not a write-
path branch.
"""

from __future__ import annotations

import asyncio
from collections.abc import AsyncIterator
from datetime import UTC, datetime
import re
from typing import Any

from crawl4ai import (
    AsyncWebCrawler,
    CacheMode,
    CrawlerRunConfig,
    HTTPCrawlerConfig,
)
from crawl4ai.async_crawler_strategy import AsyncHTTPCrawlerStrategy
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.config import settings
from app.core.log import logger
from app.core.storage import content_key
from app.services.crawler import queries
from app.services.crawler.domains.archive import THROTTLED, paced, patiently, resolve
from app.services.crawler.domains.assets import fetch_assets
from app.services.crawler.models import CrawledPage
from app.services.crawler.schemas import CrawlerSite, CrawlerStats, CrawlOptions
from app.services.crawler.utils import same_site, site_of
from app.services.system.activity import add_event


# crawl4ai's HTTP strategy raises on any non-2xx, so the result it hands
# back has ``status_code=None`` and the real status survives only in the
# error text: "HTTP 404: Unexpected status code for <url>".
_STATUS_IN_ERROR = re.compile(r"HTTP (\d{3}):")

# Page metadata crawl4ai parses out of the document, worth keeping on the
# row. Anything else the caller wants, they pass in.
_METADATA_KEYS = ("title", "description", "keywords", "author")


def _status_from_error(message: str | None) -> int | None:
    """The HTTP status buried in a crawl4ai error message, if it is one."""
    match = _STATUS_IN_ERROR.search(message or "")
    return int(match.group(1)) if match else None


async def _each(outcome: Any) -> AsyncIterator[Any]:
    """One result, a list of them, or a stream of them, as a stream."""
    if hasattr(outcome, "__aiter__"):
        async for result in outcome:
            yield result
        return
    for result in outcome if isinstance(outcome, list) else [outcome]:
        yield result


def _throttled(outcome: Any) -> bool:
    """Whether the host asked for a pause; a deep crawl's stream never does."""
    if not hasattr(outcome, "success") or getattr(outcome, "success", False):
        return False
    status = getattr(outcome, "status_code", None) or _status_from_error(
        getattr(outcome, "error_message", None)
    )
    return status in THROTTLED


def _page_metadata(result: Any) -> dict[str, Any]:
    """Title, description, keywords, author — whichever the page had."""
    parsed = getattr(result, "metadata", None) or {}
    return {
        key: parsed[key]
        for key in _METADATA_KEYS
        if isinstance(parsed, dict) and parsed.get(key)
    }


def _hash_content(content: str | None) -> str | None:
    """The digest half of the framework's content key.

    ``app.core.storage.content_key`` is the project-wide way to address
    bytes by what they are; using its digest here means this column and a
    stored object agree on identity, so bodies could move into the object
    store later without rehashing a single row.
    """
    if not content:
        return None
    return content_key(content.encode("utf-8")).rsplit("/", 1)[-1]


class CrawlerService:
    """Bulk URL fetcher with generic persistence.

    Designed to be DI-friendly: takes an ``AsyncSession`` factory rather
    than a session, so each fetch can run in its own transaction without
    the caller having to thread sessions through.

    The ``AsyncWebCrawler`` instance is lazily created on first use and
    reused across calls — ``crawl4ai`` has its own pool inside, so
    there's no benefit to one-per-call.

    Uses ``AsyncHTTPCrawlerStrategy`` (pure ``httpx``, no browser binary):
    the page is fetched as the server sends it. Client-rendered content
    needs a browser strategy, which this plugin does not ship.
    """

    def __init__(self) -> None:
        self._crawler: AsyncWebCrawler | None = None
        self._lock = asyncio.Lock()

    @staticmethod
    def http_config() -> HTTPCrawlerConfig:
        """How the fetcher identifies itself.

        ``CRAWLER_USER_AGENT`` is a declared setting, so it is read here
        rather than left as a knob that turns nothing.
        """
        return HTTPCrawlerConfig(
            headers={"User-Agent": settings.CRAWLER_USER_AGENT}
        )

    @staticmethod
    def concurrency(requested: int | None = None) -> int:
        """In-flight fetches allowed. The caller's number wins; otherwise
        ``CRAWLER_MAX_CONCURRENCY``."""
        return requested or settings.CRAWLER_MAX_CONCURRENCY

    async def _get_crawler(self) -> AsyncWebCrawler:
        """Lazily build the underlying crawler (idempotent + concurrent-safe)."""
        if self._crawler is None:
            async with self._lock:
                if self._crawler is None:
                    self._crawler = AsyncWebCrawler(
                        crawler_strategy=AsyncHTTPCrawlerStrategy(
                            browser_config=self.http_config()
                        ),
                        verbose=False,
                    )
                    await self._crawler.start()
        return self._crawler

    async def aclose(self) -> None:
        """Shut down the underlying crawler."""
        if self._crawler is not None:
            await self._crawler.close()
            self._crawler = None

    async def fetch(
        self,
        session: AsyncSession,
        *,
        url: str,
        doc_metadata: dict[str, Any] | None = None,
        source_kind: str = "crawl4ai",
        fresh: bool = False,
    ) -> CrawledPage:
        """Fetch one URL, persist the result, return the stored row.

        Failures (HTTP errors, timeouts) still produce a row so the
        crawled_page table doubles as the retry queue:
        ``WHERE status_code >= 400 OR status_code IS NULL`` is the
        unfetched-or-failed set.

        ``fresh`` bypasses both crawl4ai's network cache and the row-level
        dedup, so the URL is always fetched and always written; the
        default skips the network on a cache hit and the insert when the
        body hashed the same as the last successful fetch.
        """
        result = await self._run(url, CrawlOptions(fresh=fresh))
        return await self._store(
            session,
            result,
            url=url,
            doc_metadata=doc_metadata,
            source_kind=source_kind,
            fresh=fresh,
        )

    @staticmethod
    def run_config(options: CrawlOptions) -> CrawlerRunConfig:
        """``CrawlOptions`` as the run config crawl4ai wants.

        Only what the options name is set; every other parameter keeps
        crawl4ai's default, which is why this wraps six of them and not
        a hundred. A deep strategy is attached only when depth asks for
        one, so depth 0 is exactly the single-page fetch it always was.
        """
        config = CrawlerRunConfig(
            cache_mode=CacheMode.BYPASS if options.fresh else CacheMode.ENABLED,
            css_selector=options.selector or None,
            word_count_threshold=options.min_words or 1,
            # crawl4ai counts in milliseconds; the setting is in seconds.
            page_timeout=settings.CRAWLER_DEFAULT_TIMEOUT_S * 1000,
            # A deep crawl hands pages over as it finds them, one in
            # memory at a time, rather than the whole list at the end.
            stream=options.depth > 0,
        )
        if options.depth > 0:
            from crawl4ai.deep_crawling import BFSDeepCrawlStrategy

            config.deep_crawl_strategy = BFSDeepCrawlStrategy(
                max_depth=options.depth,
                max_pages=options.max_pages,
                include_external=not options.stay_on_domain,
            )
        return config

    async def crawl(
        self,
        session: Any,
        *,
        url: str,
        options: CrawlOptions | None = None,
        doc_metadata: dict[str, Any] | None = None,
        source_kind: str = "crawl4ai",
    ) -> AsyncIterator[CrawledPage]:
        """Fetch ``url`` and, when depth asks for it, what it links to,
        yielding each page as it is stored.

        A deep crawl streams results; a single fetch is one. Either way
        a page is stored and handed over before the next is fetched, so
        memory holds one page, not a site. ``stay_on_domain`` is enforced
        here as well as passed down: the guarantee shown in the UI is
        ours to keep.
        """
        options = options or CrawlOptions()
        outcome = await self._run(url, options)
        seed = resolve(url).url
        async for result in _each(outcome):
            # Stored as it was reached: a snapshot URL keeps its archive
            # metadata through ``_store``'s own resolve.
            reached = str(getattr(result, "url", "") or url)
            found = resolve(reached).url
            offsite = options.stay_on_domain and not same_site(seed, found)
            if offsite or (found != seed and not options.allows(found)):
                logger.debug("crawler.crawl.skipped url=%s seed=%s", found, url)
                continue
            page = await self._store(
                session,
                result,
                url=reached,
                doc_metadata=doc_metadata,
                source_kind=source_kind,
                fresh=options.fresh,
            )
            if options.assets:
                await fetch_assets(session, page)
            yield page

    async def _run(self, url: str, options: CrawlOptions) -> Any:
        """One crawl4ai run, for every fetch path: a snapshot goes on the
        wire raw, the host gets its turn, and a throttle is waited out
        and retried rather than stored as a failed page."""
        crawler = await self._get_crawler()
        fetch_url = resolve(url).fetch_url
        host = site_of(fetch_url) or ""
        if options.depth and paced(host):
            # A streamed deep crawl fetches inside crawl4ai, outside the
            # host's turns, so the archive's pace could not be kept.
            raise ValueError(
                f"{host} is paced; list the site with `crawl wayback` "
                "instead of a deep crawl"
            )
        config = self.run_config(options)
        return await patiently(
            host,
            # crawl4ai wraps ``arun`` in a decorator whose annotation reads
            # as an unbound-or-bound union to the type checker.
            lambda: crawler.arun(url=fetch_url, config=config),  # ty: ignore[missing-argument]
            _throttled,
        )

    async def _store(
        self,
        session: Any,
        result: Any,
        *,
        url: str,
        doc_metadata: dict[str, Any] | None = None,
        source_kind: str = "crawl4ai",
        fresh: bool = False,
    ) -> CrawledPage:
        """One crawl4ai result, persisted. Shared by every fetch path."""
        target = resolve(url)
        url = target.url
        source_kind = target.source_kind or source_kind
        content: str | None = None
        html: str | None = None
        content_type = "html"
        status_code: int | None = None
        flagged: dict[str, str] = {}

        if getattr(result, "success", False):
            # The markdown is what the dashboard reads; the HTML is what
            # a rebuild reads.
            html = getattr(result, "html", None) or None
            content = getattr(result, "markdown", None) or html
            if getattr(result, "markdown", None):
                content_type = "markdown"
            status_code = getattr(result, "status_code", 200) or 200
        else:
            status_code = (
                getattr(result, "status_code", None)
                or _status_from_error(getattr(result, "error_message", None))
                # Nothing said what went wrong: a timeout, a DNS miss, a
                # refused connection. 599 is the catch-all, not the norm.
                or 599
            )
            if status_code < 400:
                # The host served the page and crawl4ai's block heuristic
                # failed it anyway: an archived 2002 frame with no <body>,
                # a bare script. Those bytes are the page, so they are
                # kept, with the verdict beside them.
                html = getattr(result, "html", None) or None
                content = html
                flagged = {"flagged": getattr(result, "error_message", None) or ""}
            logger.warning(
                "crawler.fetch failed url=%s status=%s error=%s",
                url,
                status_code,
                getattr(result, "error_message", None),
            )

        new_hash = _hash_content(content)

        # Dedup gate — on by default, off when caller passed
        # ``fresh=True``. Same URL + same content hash + previous
        # successful fetch → return the existing row, no insert.
        # Skipped when content is missing or status was a failure
        # (failures always land so the retry queue stays accurate).
        if not fresh and new_hash and (status_code or 0) < 400:
            existing = await queries.page_with_hash(
                session, url=url, content_hash=new_hash
            )
            if existing is not None:
                add_event(
                    component="crawler",
                    event_type="fetch.dedup",
                    message=f"Skipped duplicate fetch of {url}",
                    status="success",
                    details=f"hash match → returning row #{existing.id}",
                )
                # The lookup opened a transaction; end it, or the connection
                # sits idle in it through the next fetch's waits. A commit,
                # not a rollback: a rollback expires the row, and the assets
                # step reads it next, outside any transaction.
                await session.commit()
                return existing

        document = CrawledPage(
            source_url=url,
            site=site_of(url),
            content=content,
            html=html,
            content_hash=new_hash,
            content_type=content_type,
            doc_metadata={
                **_page_metadata(result),
                **target.doc_metadata,
                **(doc_metadata or {}),
                **flagged,
            },
            status_code=status_code,
            source_kind=source_kind,
            fetched_at=datetime.now(UTC),
        )
        session.add(document)
        # No refresh after the commit: the session keeps its attributes
        # (expire_on_commit is off), and a refresh would open a new
        # transaction, SQLite's write lock, that outlives this page.
        await session.commit()

        # Surface every fetch in the dashboard activity feed.
        # Same convention every in-tree service uses (auth login,
        # payment.checkout, etc).
        add_event(
            component="crawler",
            event_type="fetch",
            message=f"Fetched {url}",
            status="success" if (status_code or 0) < 400 else "error",
            details=(
                f"{status_code} • {len(content or '')} bytes"
                if content
                else f"{status_code} • no content"
            ),
        )
        return document

    async def batch_fetch(
        self,
        session_factory: Any,
        *,
        urls: list[str],
        doc_metadata_for: dict[str, dict[str, Any]] | None = None,
        options: CrawlOptions | None = None,
        source_kind: str = "crawl4ai",
        max_concurrency: int | None = None,
    ) -> AsyncIterator[CrawledPage]:
        """Concurrent fetch of many URLs, yielding each page as it lands.

        ``session_factory`` is an ``async_sessionmaker`` (not a session):
        each seed opens its own session so a single failed write does
        not roll back its peers. ``doc_metadata_for`` maps URL to tags;
        URLs without entries get an empty dict. Pages come out in the
        order they finish, so nothing waits for the slowest host and
        nothing piles up. ``max_concurrency`` defaults to
        ``CRAWLER_MAX_CONCURRENCY``.
        """
        options = options or CrawlOptions()
        width = self.concurrency(max_concurrency)
        sem = asyncio.Semaphore(width)
        meta_map = doc_metadata_for or {}
        # Bounded, so a slow reader holds producers rather than pages.
        landed: asyncio.Queue[CrawledPage | None] = asyncio.Queue(maxsize=width)

        async def _one(url: str) -> None:
            async with sem, session_factory() as session:
                async for page in self.crawl(
                    session,
                    url=url,
                    options=options,
                    doc_metadata=meta_map.get(url, {}),
                    source_kind=source_kind,
                ):
                    await landed.put(page)

        async def _all() -> None:
            # Every seed runs to its end; one that raises does not stop its
            # peers, and is raised once they are done so the job says why.
            try:
                outcomes = await asyncio.gather(
                    *(_one(u) for u in urls), return_exceptions=True
                )
            finally:
                await landed.put(None)
            for url, outcome in zip(urls, outcomes, strict=True):
                if isinstance(outcome, BaseException):
                    logger.error("crawler.seed failed url=%s error=%s", url, outcome)
            failed = [o for o in outcomes if isinstance(o, BaseException)]
            if failed:
                raise failed[0]

        seeds = asyncio.create_task(_all())
        try:
            while (page := await landed.get()) is not None:
                yield page
            await seeds
        finally:
            seeds.cancel()
            await asyncio.gather(seeds, return_exceptions=True)

    async def sites(self, session: AsyncSession) -> list[CrawlerSite]:
        """Every crawled site with its page and failure counts."""
        return [
            CrawlerSite(
                site=str(site),
                pages=int(pages or 0),
                failed=int(failed or 0),
                last_fetched_at=last.isoformat() if last else None,
            )
            for site, pages, failed, last in await queries.site_rollup(session)
        ]

    async def list_pages(
        self,
        session: AsyncSession,
        *,
        limit: int = 50,
        failed_only: bool = False,
        site: str | None = None,
    ) -> list[CrawledPage]:
        """Return the most recent N pages, newest first."""
        return await queries.recent_pages(
            session, limit=limit, failed_only=failed_only, site=site
        )

    async def stats(self, session: AsyncSession) -> CrawlerStats:
        """Aggregate counts, distinct URLs, content-type split, last fetch.

        Single source of truth for the dashboard overview surfaces:

        - the FastAPI route ``GET /api/v1/crawler/stats`` returns this
        - ``crawler_health`` calls this so health metadata stays in lockstep
        - the dashboard modal hits the same route via ``api_client``

        No call site re-implements the count queries, and the whole
        payload is two statements: one aggregate row, one grouped
        content-type split.
        """
        pages, failed, unique_urls, last = await queries.totals(session)
        return CrawlerStats(
            pages=pages,
            failed=failed,
            unique_urls=unique_urls,
            content_types=await queries.content_type_counts(session),
            last_fetched_at=last.isoformat() if last else None,
        )
