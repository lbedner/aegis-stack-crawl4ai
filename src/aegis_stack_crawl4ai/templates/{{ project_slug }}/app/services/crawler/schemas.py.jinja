"""Pydantic request / response schemas for the crawler API."""

from __future__ import annotations

from datetime import datetime
from fnmatch import fnmatch
from typing import Annotated, Any

from pydantic import BaseModel, Field, HttpUrl, field_validator

from app.services.crawler.utils import normalize_url

MAX_DEPTH = 3
"""Deepest link-following allowed.

Depth is exponential in someone else's bandwidth, so this is a hard
ceiling rather than a default that can be argued up per call.
"""


class CrawlOptions(BaseModel):
    """Tunables for one crawl. Defaults reproduce the single-page fetch.

    ``CrawlerRunConfig`` takes about a hundred parameters. These are
    the handful that change what a person actually gets back, so they
    are the ones the API, the CLI and the dashboard share. Everything
    else keeps crawl4ai's own default.
    """

    depth: int = Field(
        default=0,
        ge=0,
        le=MAX_DEPTH,
        description="How many links deep to follow. 0 fetches only the URLs given.",
    )
    max_pages: int = Field(
        default=25,
        ge=1,
        le=500,
        description="Ceiling on pages fetched per seed URL when depth > 0.",
    )
    stay_on_domain: bool = Field(
        default=True,
        description="Follow links only within the seed URL's registrable site.",
    )
    selector: str | None = Field(
        default=None,
        max_length=200,
        description="CSS selector: keep only this part of each page.",
    )
    min_words: int = Field(
        default=0,
        ge=0,
        le=1000,
        description="Drop blocks shorter than this many words (nav, chrome).",
    )
    fresh: bool = Field(
        default=False,
        description="Bypass the cache and the store's dedup; always refetch.",
    )
    assets: bool = Field(
        default=False,
        description="Also fetch each page's images, stylesheets, scripts and downloads.",
    )
    include: list[str] = Field(
        default_factory=list,
        max_length=20,
        description="Keep only URLs matching one of these globs; empty is all.",
    )
    exclude: list[str] = Field(
        default_factory=list,
        max_length=20,
        description="Drop URLs matching one of these globs.",
    )

    def allows(self, url: str) -> bool:
        """Whether a URL passes the globs: in one of ``include`` (or none
        given), and in none of ``exclude``. The one rule for the archive
        listing and for what a deep crawl keeps."""
        if any(fnmatch(url, pattern) for pattern in self.exclude):
            return False
        return not self.include or any(
            fnmatch(url, pattern) for pattern in self.include
        )


class CrawlerStats(BaseModel):
    """Aggregate counts the dashboard, the CLI and the health check share."""

    pages: int = 0
    failed: int = 0
    unique_urls: int = 0
    content_types: dict[str, int] = Field(default_factory=dict)
    last_fetched_at: str | None = None


class CrawlerSite(BaseModel):
    """One crawled site and how much of it is in the store.

    A deep crawl of one seed lands as many rows; this is the row the
    dashboard lists before anyone drills into pages.
    """

    site: str
    pages: int = 0
    failed: int = 0
    last_fetched_at: str | None = None


class CrawledPageResult(BaseModel):
    """One page a crawl produced, as the job result carries it.

    ``preview`` is the opening of the body, not the body: these ride an
    SSE frame. ``size`` is the real length, so a truncated preview is
    still honest about what was fetched.
    """

    id: int | None = None
    url: str
    status: int | None = None
    content_type: str = ""
    size: int = 0
    preview: str = ""


class CrawlSummary(BaseModel):
    """What a crawl job returns: the counts, and a sample of the pages."""

    requested: int = 0
    fetched: int = 0
    failed: int = 0
    pages: list[CrawledPageResult] = Field(default_factory=list)


class StoredExport(BaseModel):
    """A site's export in the object store: its pages and manifest under
    one content key, its assets under the keys the manifest names."""

    site: str
    key: str
    size: int
    pages: int
    assets: int
    url: str | None = None
    """A time-limited link to the zip, when the store can hand one out."""


class BatchCrawlRequest(BaseModel):
    """Inbound request: fetch many URLs as one background job."""

    urls: list[HttpUrl] = Field(min_length=1, max_length=500)
    options: CrawlOptions = Field(default_factory=CrawlOptions)

    @field_validator("urls", mode="before")
    @classmethod
    def _accept_bare_domains(cls, value: Any) -> Any:
        if isinstance(value, list):
            return [
                normalize_url(item) if isinstance(item, str) else item
                for item in value
            ]
        return value
    source_kind: str = Field(
        default="crawl4ai",
        max_length=32,
        description="Producer label stored on every row this job writes.",
    )


CaptureTs = Annotated[str | None, Field(default=None, pattern=r"^\d{4,14}$")]
"""A Wayback timestamp prefix, ``YYYY`` through ``YYYYMMDDhhmmss``."""


class WaybackRequest(BaseModel):
    """Inbound request: fetch every archived page of a site as one job."""

    domain: str = Field(min_length=1, max_length=255)
    from_ts: CaptureTs = None
    to_ts: CaptureTs = None
    options: CrawlOptions = Field(default_factory=CrawlOptions)

    @field_validator("from_ts", "to_ts", mode="before")
    @classmethod
    def _accept_calendar_dates(cls, value: Any) -> Any:
        """A calendar's ISO date (``2017-05-01``) is the archive's
        ``20170501``: the Overseer and the dashboard pick dates, the CLI
        types prefixes, and both land as one."""
        return value.replace("-", "") if isinstance(value, str) else value


class CrawlRequest(BaseModel):
    """Inbound request: fetch one URL and store the result."""

    url: HttpUrl

    @field_validator("url", mode="before")
    @classmethod
    def _accept_a_bare_domain(cls, value: Any) -> Any:
        return normalize_url(value) if isinstance(value, str) else value
    doc_metadata: dict[str, Any] = Field(
        default_factory=dict,
        description=(
            "Caller-supplied tags attached to the stored document. Free-"
            "form JSONB; use it to thread your domain identifiers through "
            "(e.g. ``{'ign_id': 5208, 'cluster': 9}``)."
        ),
    )
    source_kind: str = Field(
        default="crawl4ai",
        max_length=32,
        description=(
            "Producer label. Multiple producers can share the pages "
            "table; this column lets you filter by origin."
        ),
    )
    fresh: bool = Field(
        default=False,
        description=(
            "When ``true``, bypass crawl4ai's network cache AND skip "
            "row-level dedup — every call hits the live URL and "
            "always writes a new row. Default ``false`` is the fast "
            "path: cache hits skip the network, identical content "
            "skips the insert. Use ``fresh=true`` when you suspect "
            "the cached body is stale, or when you need write-"
            "history semantics."
        ),
    )


class CrawledPageSummary(BaseModel):
    """Outbound shape of a stored document in a listing: everything but
    the HTML, which the listing query does not even load."""

    id: int
    source_url: str
    site: str | None
    content: str | None
    content_hash: str | None
    content_type: str
    doc_metadata: dict[str, Any]
    status_code: int | None
    source_kind: str
    fetched_at: datetime

    model_config = {"from_attributes": True}


class CrawledPageRead(CrawledPageSummary):
    """One stored document in full, HTML included."""

    html: str | None = None


class CrawledAssetRead(BaseModel):
    """One asset a stored page references, and where its bytes are."""

    id: int
    page_id: int | None
    site: str
    original_url: str
    content_type: str | None
    size: int
    storage_key: str | None
    status_code: int | None
    fetched_at: datetime

    model_config = {"from_attributes": True}



def summary_of(page: Any) -> dict[str, Any]:
    """A stored page as its summary, body left out: what a list carries."""
    return CrawledPageSummary.model_validate(page).model_dump(
        mode="json", exclude={"content"}
    )

