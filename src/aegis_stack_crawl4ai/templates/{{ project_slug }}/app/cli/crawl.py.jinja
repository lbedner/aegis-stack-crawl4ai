"""Crawler CLI: a thin client of the running webserver's crawler routes.

Same shape as ``app/cli/health.py``: an ``httpx`` client against the
configured ``API_BASE_URL``, no raw DB calls. ``<project> crawl --help``
lists the commands.
"""

from __future__ import annotations

import asyncio
import io
import json
from pathlib import Path
import sys
from typing import Any
import zipfile

import httpx
from rich import box
from rich.console import Console
from rich.markdown import Markdown
from rich.panel import Panel
from rich.syntax import Syntax
from rich.table import Table
import typer

from app.components.backend.api.crawler import API_PREFIX
from app.core.config import settings
from app.core.constants import Defaults
from app.core.formatting import format_bytes, format_relative_time
from app.services.crawler.domains.export import MANIFEST
from app.services.crawler.schemas import (
    MAX_DEPTH,
    CrawlOptions,
    CrawlSummary,
    StoredExport,
)

app = typer.Typer(
    name="crawl",
    help="Web crawling and scraping (Crawl4AI plugin).",
    no_args_is_help=True,
)
console = Console()


def _api_base() -> str:
    # Fall back to the port this project actually serves on, not a
    # hardcoded 8000: whatever else is listening there answers first,
    # and its 401 looks like ours.
    port = getattr(settings, "PORT", 8000)
    return getattr(settings, "API_BASE_URL", None) or f"http://localhost:{port}"


def _client() -> httpx.AsyncClient:
    return httpx.AsyncClient(
        base_url=_api_base(),
        timeout=httpx.Timeout(getattr(Defaults, "API_TIMEOUT", 30.0)),
    )


def _status(status_code: Any) -> str:
    """A status code in the one colour every command agrees on: green
    when the fetch landed, red when it did not, a dash when unknown."""
    code = status_code or 0
    colour = "green" if 0 < code < 400 else "red"
    return f"[{colour}]{code or '—'}[/{colour}]"


def _fetch_table(title: str, rows: list[dict[str, Any]], *, url: str) -> Table:
    """Fetched things, one shape: status, size, type when known, URL."""
    typed = any(row.get("content_type") for row in rows)
    table = Table(title=title, box=box.SIMPLE)
    table.add_column("status", justify="right")
    table.add_column("size", justify="right")
    if typed:
        table.add_column("type")
    table.add_column("url")
    for row in rows:
        cells = [_status(row.get("status")), format_bytes(row.get("size") or 0)]
        if typed:
            cells.append(row.get("content_type") or "")
        table.add_row(*cells, row.get(url) or "")
    return table


def _parse_metadata(pairs: list[str]) -> dict[str, Any]:
    """Parse ``-m key=value`` pairs into a dict.

    Values that parse as JSON are decoded (so ``-m count=5`` → int);
    otherwise treated as strings.
    """
    out: dict[str, Any] = {}
    for pair in pairs:
        if "=" not in pair:
            raise typer.BadParameter(
                f"--metadata expects key=value, got {pair!r}"
            )
        key, raw = pair.split("=", 1)
        try:
            out[key] = json.loads(raw)
        except json.JSONDecodeError:
            out[key] = raw
    return out


@app.command(help="Show document counts + last fetch timestamp.")
async def stats() -> None:
    async with _client() as client:
        resp = await client.get(f"{API_PREFIX}/stats")
        resp.raise_for_status()
        data = resp.json()

    failed = data.get("failed", 0) or 0
    failed_color = "red" if failed else "green"

    table = Table(title="Crawler stats", show_header=False, title_style="bold magenta")
    table.add_column("metric", style="cyan", no_wrap=True)
    table.add_column("value", style="bold")
    table.add_row("Pages", f"[green]{data.get('pages', 0):,}[/green]")
    table.add_row("Failed", f"[{failed_color}]{failed:,}[/{failed_color}]")
    table.add_row(
        "Last fetch",
        f"[yellow]{format_relative_time(data.get('last_fetched_at'))}[/yellow]",
    )
    console.print(table)


@app.command(help="Fetch one URL and persist the result.")
async def fetch(
    url: str = typer.Argument(..., help="URL to fetch."),
    metadata: list[str] = typer.Option(
        [], "--metadata", "-m", help="Repeatable key=value tags; values JSON-decoded."
    ),
    source_kind: str = typer.Option(
        "crawl4ai", "--source-kind", help="Producer label stored on the row."
    ),
    fresh: bool = typer.Option(
        False, "--fresh", help="Bypass the cache and dedup; always refetch."
    ),
) -> None:
    # The newest id before the call tells a new row from a deduped one:
    # an id at or below it means the API returned an existing row.
    async with _client() as client:
        prior_resp = await client.get(f"{API_PREFIX}/pages", params={"limit": 1})
        prior_resp.raise_for_status()
        prior_rows = prior_resp.json()
        prior_max_id = prior_rows[0]["id"] if prior_rows else 0

        payload = {
            "url": url,
            "doc_metadata": _parse_metadata(metadata),
            "source_kind": source_kind,
            "fresh": fresh,
        }
        resp = await client.post(f"{API_PREFIX}/crawl", json=payload)
        if resp.status_code >= 400:
            console.print(
                f"[red]Fetch failed:[/red] {resp.status_code} {resp.text}",
            )
            raise typer.Exit(1)
        doc = resp.json()

    status_code = doc.get("status_code") or 0
    deduped = (not fresh) and doc["id"] <= prior_max_id

    if deduped:
        marker, suffix = "[cyan]↻[/cyan]", " [cyan](cached • hash match)[/cyan]"
    elif status_code < 400:
        marker, suffix = "[green]✓[/green]", ""
    else:
        marker, suffix = "[red]✗[/red]", ""

    console.print(
        f"{marker} "
        f"[cyan]id={doc['id']}[/cyan] "
        f"status={_status(status_code)} "
        f"[yellow]type={doc.get('content_type')}[/yellow] "
        f"[dim]bytes={format_bytes(len(doc.get('content') or ''))}[/dim]"
        f"{suffix}"
    )


@app.command(help="Crawl one or more URLs as a background job.")
async def site(
    urls: list[str] = typer.Argument(..., help="Seed URLs. A bare domain is fine."),
    depth: int = typer.Option(
        0, "--depth", "-d", min=0, max=MAX_DEPTH, help="How many links deep to follow."
    ),
    max_pages: int = typer.Option(
        25, "--max-pages", min=1, max=500, help="Ceiling on pages per seed URL."
    ),
    selector: str = typer.Option(
        "", "--selector", help="CSS selector: keep only this part of each page."
    ),
    min_words: int = typer.Option(
        0, "--min-words", min=0, help="Drop blocks shorter than this many words."
    ),
    external: bool = typer.Option(
        False, "--external", help="Follow links off the seed URL's site."
    ),
    fresh: bool = typer.Option(False, "--fresh", help="Bypass cache and dedup."),
    assets: bool = typer.Option(
        False, "--assets", help="Also fetch each page's images, styles, scripts."
    ),
    source_kind: str = typer.Option("crawl4ai", "--source-kind"),
) -> None:
    """The same job the dashboard starts, from a terminal."""
    options = CrawlOptions(
        depth=depth,
        max_pages=max_pages,
        selector=selector or None,
        min_words=min_words,
        stay_on_domain=not external,
        fresh=fresh,
        assets=assets,
    )

    await _run_job(
        "/crawl-batch",
        {"urls": urls, "options": options.model_dump(), "source_kind": source_kind},
    )


@app.command(help="Fetch every archived page of a site from the Wayback Machine.")
async def wayback(
    domain: str = typer.Argument(..., help="The archived site, e.g. example.com."),
    from_ts: str = typer.Option("", "--from", help="Earliest capture, YYYYMMDD."),
    to_ts: str = typer.Option("", "--to", help="Latest capture, YYYYMMDD."),
    include: list[str] = typer.Option(
        [], "--include", help="Only pages matching this glob (repeatable)."
    ),
    exclude: list[str] = typer.Option(
        [], "--exclude", help="Skip pages matching this glob (repeatable)."
    ),
    fresh: bool = typer.Option(
        False, "--fresh", help="Refetch pages the store already has."
    ),
    assets: bool = typer.Option(
        False, "--assets", help="Also fetch each page's images, styles, scripts."
    ),
) -> None:
    """One CDX listing, then the latest capture of each page, filed
    under its original URL."""
    options = CrawlOptions(
        include=include, exclude=exclude, fresh=fresh, assets=assets
    )
    await _run_job(
        "/wayback",
        {
            "domain": domain,
            "from_ts": from_ts or None,
            "to_ts": to_ts or None,
            "options": options.model_dump(),
        },
    )


async def _follow(path: str, payload: dict[str, Any], *, doing: str) -> dict[str, Any]:
    """Start a crawler job, follow its label until it lands; the job's
    snapshot, or exit 1 with why it failed."""
    async with _client() as client:
        resp = await client.post(f"{API_PREFIX}{path}", json=payload)
        resp.raise_for_status()
        job_id = resp.json()["job_id"]

        console.print(f"[dim]job {job_id}[/dim]")
        with console.status(doing) as status:
            while True:
                await asyncio.sleep(1.0)
                job = (await client.get(f"/api/v1/jobs/{job_id}")).json()
                status.update(job.get("label") or doing)
                if job.get("status") != "running":
                    break

    if job.get("status") != "done":
        console.print(f"[red]{job.get('error') or 'The job failed.'}[/red]")
        raise typer.Exit(1)
    return job


async def _run_job(path: str, payload: dict[str, Any], *, noun: str = "page") -> None:
    """Start a crawl job, follow it, print what it got."""
    job = await _follow(path, payload, doing="Crawling...")
    summary = CrawlSummary.model_validate(job.get("result") or {})
    rows = [page.model_dump() for page in summary.pages]
    console.print(_fetch_table(f"Crawled {summary.fetched} {noun}(s)", rows, url="url"))
    if summary.failed:
        console.print(f"[yellow]{summary.failed} failed[/yellow]")


@app.command(help="Fetch the assets a crawled site's pages name and do not have yet.")
async def assets(
    site: str = typer.Argument(..., help="The site, as `crawl list` names it."),
) -> None:
    """Pages crawled before --assets, pages an archive pull skipped, and
    assets whose fetch was throttled: one pass picks them all up."""
    await _run_job(f"/sites/{site}/assets", {}, noun="asset")


@app.command(help="Keep a crawled site's export in the object store, or unpack it.")
async def export(
    site: str = typer.Argument(..., help="The site, as `crawl list` names it."),
    directory: Path | None = typer.Argument(
        None, help="Unpack here instead of keeping the zip in the object store."
    ),
) -> None:
    """Pages as HTML and markdown at their URL paths, assets at theirs,
    and a manifest.json naming them all, as one zip. Its home is the
    object store (the bucket), which outlives the stack; a directory is
    for looking at it here. Re-running overwrites the directory."""
    if directory is None:
        job = await _follow(f"/sites/{site}/export", {}, doing="Packing...")
        kept = StoredExport.model_validate(job.get("result") or {})
        console.print(
            f"[green]✓[/green] {kept.pages} page(s), {kept.assets} asset(s), "
            f"{format_bytes(kept.size)} → [cyan]{kept.key}[/cyan]"
        )
        if kept.url:
            console.print(f"[dim]{kept.url}[/dim]")
        return
    async with _client() as client:
        resp = await client.get(
            f"{API_PREFIX}/sites/{site}/export", timeout=httpx.Timeout(600.0)
        )
        resp.raise_for_status()
    archive = zipfile.ZipFile(io.BytesIO(resp.content))
    archive.extractall(directory)
    manifest = json.loads(archive.read(MANIFEST))
    console.print(
        f"[green]✓[/green] {len(manifest['pages'])} page(s), "
        f"{len(manifest['assets'])} asset(s) → {directory}"
    )


@app.command("list", help="List recent pages.")
async def list_pages(
    limit: int = typer.Option(20, "--limit", "-n", help="Max rows to show."),
    failed: bool = typer.Option(
        False, "--failed", help="Only show fetches with status >= 400."
    ),
) -> None:
    params: dict[str, Any] = {"limit": limit}
    if failed:
        params["failed_only"] = "true"

    async with _client() as client:
        resp = await client.get(f"{API_PREFIX}/pages", params=params)
        resp.raise_for_status()
        rows = resp.json()

    if not rows:
        console.print("[yellow]No pages yet.[/yellow]")
        return

    table = Table(
        title=f"Crawled pages ({len(rows)})",
        show_header=True,
        header_style="bold magenta",
        title_style="bold magenta",
    )
    table.add_column("id", justify="right", style="cyan", no_wrap=True)
    table.add_column("status", justify="right", style="bold")
    table.add_column("type", style="yellow")
    table.add_column("bytes", justify="right", style="dim")
    table.add_column("fetched_at", style="dim")
    table.add_column("url", style="green", overflow="fold")
    for r in rows:
        table.add_row(
            str(r["id"]),
            _status(r.get("status_code")),
            r.get("content_type") or "",
            format_bytes(len(r.get("content") or "")),
            format_relative_time(r.get("fetched_at")),
            r.get("source_url") or "",
        )
    console.print(table)
    console.print(f"\n[cyan]Total pages shown:[/cyan] {len(rows)}")


@app.command(help="Show one document's body + metadata.")
async def show(
    page_id: int = typer.Argument(..., help="CrawledPage id to render."),
    raw: bool = typer.Option(
        False,
        "--raw",
        help="Print body as plain text instead of rendered Markdown / "
        "syntax-highlighted HTML.",
    ),
    head: int = typer.Option(
        0,
        "--head",
        "-h",
        help="Print only the first N characters of the body. 0 = full.",
    ),
    html: bool = typer.Option(
        False, "--html", help="Print the stored HTML instead of the markdown."
    ),
) -> None:
    async with _client() as client:
        resp = await client.get(f"{API_PREFIX}/pages/{page_id}")
        if resp.status_code == 404:
            console.print(f"[red]No document with id={page_id}[/red]")
            raise typer.Exit(1)
        resp.raise_for_status()
        doc = resp.json()
        assets = (await client.get(f"{API_PREFIX}/pages/{page_id}/assets")).json()

    status_code = doc.get("status_code") or 0

    # Header table — id, url, status, content_type, fetched_at, metadata.
    header = Table(
        title=f"CrawledPage #{doc['id']}",
        show_header=False,
        box=None,
        pad_edge=False,
        title_style="bold magenta",
    )
    header.add_column("k", style="cyan", no_wrap=True)
    header.add_column("v", overflow="fold")
    header.add_row("source_url", f"[green]{doc.get('source_url') or ''}[/green]")
    header.add_row("status", _status(status_code))
    header.add_row("content_type", f"[yellow]{doc.get('content_type') or ''}[/yellow]")
    header.add_row("source_kind", f"[dim]{doc.get('source_kind') or ''}[/dim]")
    header.add_row(
        "fetched_at", f"[dim]{format_relative_time(doc.get('fetched_at'))}[/dim]"
    )
    header.add_row("hash", f"[dim]{doc.get('content_hash') or ''}[/dim]")
    if doc.get("doc_metadata"):
        header.add_row("metadata", json.dumps(doc["doc_metadata"]))
    console.print(header)
    console.print()
    if assets:
        rows = [{**a, "status": a.get("status_code")} for a in assets]
        console.print(_fetch_table(f"{len(assets)} asset(s)", rows, url="original_url"))

    body = doc.get("html" if html else "content") or ""
    if not body:
        console.print("[dim](no body)[/dim]")
        return
    if head and head > 0:
        body = body[:head]

    if raw:
        console.print(body)
        return

    content_type = "html" if html else (doc.get("content_type") or "").lower()
    if content_type == "markdown":
        console.print(Panel(Markdown(body), title="content", border_style="dim"))
    elif content_type in ("html", "json"):
        console.print(
            Panel(
                Syntax(body, content_type, theme="ansi_dark", word_wrap=True),
                title=f"content ({content_type})",
                border_style="dim",
            )
        )
    else:
        console.print(Panel(body, title="content", border_style="dim"))


@app.command("retry-failed", help="Re-fetch every document with status >= 400.")
async def retry_failed(
    limit: int = typer.Option(50, "--limit", "-n", help="Max retries."),
) -> None:
    async with _client() as client:
        resp = await client.get(
            f"{API_PREFIX}/pages",
            params={"limit": limit, "failed_only": "true"},
        )
        resp.raise_for_status()
        failed_rows = resp.json()

        if not failed_rows:
            console.print("[green]✓ Nothing to retry.[/green]")
            return

        console.print(
            f"[bold yellow]Retrying {len(failed_rows)} failed fetches…[/bold yellow]"
        )
        successes = 0
        for row in failed_rows:
            # A snapshot row retries through the archive, not the live host.
            meta = row.get("doc_metadata") or {}
            url = meta.get("archive_url") or row.get("source_url")
            if not url:
                continue
            payload = {
                "url": url,
                "doc_metadata": row.get("doc_metadata") or {},
                "source_kind": row.get("source_kind") or "crawl4ai",
            }
            try:
                r = await client.post(f"{API_PREFIX}/crawl", json=payload)
                if r.status_code < 400:
                    new_doc = r.json()
                    new_status = new_doc.get("status_code") or 0
                    if new_status < 400:
                        successes += 1
                        console.print(f"  [green]✓[/green] [dim]{url}[/dim]")
                    else:
                        console.print(
                            f"  [red]✗[/red] [dim]{url}[/dim] "
                            f"[red](status {new_status})[/red]"
                        )
            except httpx.HTTPError as exc:
                console.print(
                    f"  [red]✗[/red] [dim]{url}[/dim]: [red]{exc}[/red]",
                    markup=True,
                )

    fail_count = len(failed_rows) - successes
    console.print(
        f"\n[bold]Retried[/bold] [cyan]{len(failed_rows)}[/cyan] • "
        f"[green]{successes} succeeded[/green] • "
        f"[red]{fail_count} still failing[/red]"
    )


if __name__ == "__main__":
    sys.exit(app())
