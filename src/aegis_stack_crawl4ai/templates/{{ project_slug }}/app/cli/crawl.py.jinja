@app.command(help="Show one document's body + metadata.")
async def show(
    page_id: int = typer.Argument(..., help="CrawledPage id to render."),
    raw: bool = typer.Option(
        False,
        "--raw",
        help="Print body as plain text instead of rendered Markdown / "
        "syntax-highlighted HTML.",
    ),
    head: int = typer.Option(
        0,
        "--head",
        "-h",
        help="Print only the first N characters of the body. 0 = full.",
    ),
) -> None:
    async with _client() as client:
        resp = await client.get(f"{API_PREFIX}/pages/{page_id}")
        if resp.status_code == 404:
            console.print(f"[red]No document with id={page_id}[/red]")
            raise typer.Exit(1)
        resp.raise_for_status()
        doc = resp.json()

    status_code = doc.get("status_code") or 0

    # Header table — id, url, status, content_type, fetched_at, metadata.
    header = Table(
        title=f"CrawledPage #{doc['id']}",
        show_header=False,
        box=None,
        pad_edge=False,
        title_style="bold magenta",
    )
    header.add_column("k", style="cyan", no_wrap=True)
    header.add_column("v", overflow="fold")
    header.add_row("source_url", f"[green]{doc.get('source_url') or ''}[/green]")
    header.add_row("status", _status(status_code))
    header.add_row("content_type", f"[yellow]{doc.get('content_type') or ''}[/yellow]")
    header.add_row("source_kind", f"[dim]{doc.get('source_kind') or ''}[/dim]")
    header.add_row(
        "fetched_at", f"[dim]{format_relative_time(doc.get('fetched_at'))}[/dim]"
    )
    header.add_row("hash", f"[dim]{doc.get('content_hash') or ''}[/dim]")
    if doc.get("doc_metadata"):
        header.add_row("metadata", json.dumps(doc["doc_metadata"]))
    console.print(header)
    console.print()

    body = doc.get("content") or ""
    if not body:
        console.print("[dim](no body)[/dim]")
        return
    if head and head > 0:
        body = body[:head]

    if raw:
        console.print(body)
        return

    content_type = (doc.get("content_type") or "").lower()
    if content_type == "markdown":
        console.print(Panel(Markdown(body), title="content", border_style="dim"))
    elif content_type in ("html", "json"):
        console.print(
            Panel(
                Syntax(body, content_type, theme="ansi_dark", word_wrap=True),
                title=f"content ({content_type})",
                border_style="dim",
            )
        )
    else:
        console.print(Panel(body, title="content", border_style="dim"))


# ---------------------------------------------------------------------
# retry-failed
# ---------------------------------------------------------------------


@app.command("retry-failed", help="Re-fetch every document with status >= 400.")
async def retry_failed(
    limit: int = typer.Option(50, "--limit", "-n", help="Max retries."),
) -> None:
    async with _client() as client:
        resp = await client.get(
            f"{API_PREFIX}/pages",
            params={"limit": limit, "failed_only": "true"},
        )
        resp.raise_for_status()
        failed_rows = resp.json()

        if not failed_rows:
            console.print("[green]✓ Nothing to retry.[/green]")
            return

        console.print(
            f"[bold yellow]Retrying {len(failed_rows)} failed fetches…[/bold yellow]"
        )
        successes = 0
        for row in failed_rows:
            url = row.get("source_url")
            if not url:
                continue
            payload = {
                "url": url,
                "doc_metadata": row.get("doc_metadata") or {},
                "source_kind": row.get("source_kind") or "crawl4ai",
            }
            try:
                r = await client.post(f"{API_PREFIX}/crawl", json=payload)
                if r.status_code < 400:
                    new_doc = r.json()
                    new_status = new_doc.get("status_code") or 0
                    if new_status < 400:
                        successes += 1
                        console.print(f"  [green]✓[/green] [dim]{url}[/dim]")
                    else:
                        console.print(
                            f"  [red]✗[/red] [dim]{url}[/dim] "
                            f"[red](status {new_status})[/red]"
                        )
            except httpx.HTTPError as exc:
                console.print(
                    f"  [red]✗[/red] [dim]{url}[/dim]: [red]{exc}[/red]",
                    markup=True,
                )

    fail_count = len(failed_rows) - successes
    console.print(
        f"\n[bold]Retried[/bold] [cyan]{len(failed_rows)}[/cyan] • "
        f"[green]{successes} succeeded[/green] • "
        f"[red]{fail_count} still failing[/red]"
    )


if __name__ == "__main__":
    sys.exit(app())
