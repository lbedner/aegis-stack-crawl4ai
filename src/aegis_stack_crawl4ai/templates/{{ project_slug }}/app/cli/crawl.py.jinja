@app.command(help="Crawl one or more URLs as a background job.")
async def site(
    urls: list[str] = typer.Argument(..., help="Seed URLs. A bare domain is fine."),
    depth: int = typer.Option(
        0, "--depth", "-d", min=0, max=MAX_DEPTH, help="How many links deep to follow."
    ),
    max_pages: int = typer.Option(
        25, "--max-pages", min=1, max=500, help="Ceiling on pages per seed URL."
    ),
    selector: str = typer.Option(
        "", "--selector", help="CSS selector: keep only this part of each page."
    ),
    min_words: int = typer.Option(
        0, "--min-words", min=0, help="Drop blocks shorter than this many words."
    ),
    external: bool = typer.Option(
        False, "--external", help="Follow links off the seed URL's site."
    ),
    fresh: bool = typer.Option(False, "--fresh", help="Bypass cache and dedup."),
    source_kind: str = typer.Option("crawl4ai", "--source-kind"),
) -> None:
    """The same job the dashboard starts, from a terminal."""
    options = CrawlOptions(
        depth=depth,
        max_pages=max_pages,
        selector=selector or None,
        min_words=min_words,
        stay_on_domain=not external,
        fresh=fresh,
    )

    async with _client() as client:
        resp = await client.post(
            f"{API_PREFIX}/crawl-batch",
            json={
                "urls": urls,
                "options": options.model_dump(),
                "source_kind": source_kind,
            },
        )
        resp.raise_for_status()
        job_id = resp.json()["job_id"]

        console.print(f"[dim]job {job_id}[/dim]")
        with console.status("Crawling...") as status:
            while True:
                await asyncio.sleep(1.0)
                job = (await client.get(f"/api/v1/jobs/{job_id}")).json()
                status.update(job.get("label") or "Crawling...")
                if job.get("status") != "running":
                    break

    if job.get("status") != "done":
        console.print(f"[red]{job.get('error') or 'The crawl failed.'}[/red]")
        raise typer.Exit(1)

    summary = CrawlSummary.model_validate(job.get("result") or {})
    table = Table(title=f"Crawled {summary.fetched} page(s)", box=box.SIMPLE)
    table.add_column("status", justify="right")
    table.add_column("size", justify="right")
    table.add_column("url")
    for page in summary.pages:
        table.add_row(_status(page.status), format_bytes(page.size), page.url)
    console.print(table)
    if summary.failed:
        console.print(f"[yellow]{summary.failed} failed[/yellow]")


@app.command("list", help="List recent pages.")
async def list_pages(
    limit: int = typer.Option(20, "--limit", "-n", help="Max rows to show."),
    failed: bool = typer.Option(
        False, "--failed", help="Only show fetches with status >= 400."
    ),
) -> None:
    params: dict[str, Any] = {"limit": limit}
    if failed:
        params["failed_only"] = "true"

    async with _client() as client:
        resp = await client.get(f"{API_PREFIX}/pages", params=params)
        resp.raise_for_status()
        rows = resp.json()

    if not rows:
        console.print("[yellow]No pages yet.[/yellow]")
        return

    table = Table(
        title=f"Crawled pages ({len(rows)})",
        show_header=True,
        header_style="bold magenta",
        title_style="bold magenta",
    )
    table.add_column("id", justify="right", style="cyan", no_wrap=True)
    table.add_column("status", justify="right", style="bold")
    table.add_column("type", style="yellow")
    table.add_column("bytes", justify="right", style="dim")
    table.add_column("fetched_at", style="dim")
    table.add_column("url", style="green", overflow="fold")
    for r in rows:
        table.add_row(
            str(r["id"]),
            _status(r.get("status_code")),
            r.get("content_type") or "",
            format_bytes(len(r.get("content") or "")),
            format_relative_time(r.get("fetched_at")),
            r.get("source_url") or "",
        )
    console.print(table)
    console.print(f"\n[cyan]Total pages shown:[/cyan] {len(rows)}")


